MONZO_CLIENT_ID=your-monzo-client-id
MONZO_CLIENT_SECRET=your-monzo-client-secret
MONZO_REDIRECT_URI=http://127.0.0.1:8000/monzo-callback
DATABASE_URL=sqlite:///./monzo_scheduler.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-base64-key-from-Fernet.generate_key
BFF_API_KEY=replace-with-a-long-random-secret-shared-with-the-nextjs-bff
JWT_EXPIRATION_SECONDS=900
APP_ENV=development

# Direct OpenTelemetry export; disabled until configured by the operator.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=schedzo
OTEL_EXPORTER_OTLP_ENDPOINT=
# Copy the Grafana Cloud OTLP Authorization header; URL-encode spaces as %20.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=1.0
